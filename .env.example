# ── Required ───────────────────────────────────────────────────────────
# Comma-separated admin API keys used by the Android app / web panel.
# Each key must be at least 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEYS=

# The same string you type in Meta App Dashboard > WhatsApp > Configuration > Webhook "Verify token".
WEBHOOK_VERIFY_TOKEN=

# Meta App Secret (App Dashboard > Settings > Basic). Used to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=

# 32-byte key (64 hex chars or base64) used to encrypt access tokens stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if you lose it, saved access tokens cannot be decrypted.
ENCRYPTION_KEY=

# ── Optional ───────────────────────────────────────────────────────────
PORT=7860
# Folder for the SQLite database. MUST be on a persistent disk/volume in production.
DATA_DIR=./data
# DATABASE_PATH=./data/whatsapp-server.db

# Set to 1 when running behind a reverse proxy (Render, Hugging Face, Nginx, ...) so client IPs are correct.
TRUST_PROXY=false

# Comma-separated allowed browser origins for a web panel. Leave empty if you only use the Android app.
CORS_ORIGINS=

GRAPH_API_VERSION=v23.0
MESSAGE_LOG_RETENTION_DAYS=30
# Store message text in the log table (off by default for privacy).
STORE_MESSAGE_TEXT=false

# Optional single-number bootstrap: when ALL THREE are set, an account is created on first start.
# The token is read from the environment at send time and is never copied into the database.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=

# Local development only (never in production): accept webhooks without signature verification.
# ALLOW_UNSIGNED_WEBHOOKS=false
